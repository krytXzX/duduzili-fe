{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/manifest.webmanifest",
          "/favicon.ico",
          "/icons/icon-192x192.png",
          "/icons/icon-512x512.png",
          "/*.css",
          "/main-*.js",
          "/polyfills-*.js"
        ]
      }
    },
    {
      "name": "application-chunks",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/*.js"
        ]
      }
    },
    {
      "name": "homepage-hero",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/images/home-hero-bg.png",
          "/assets/images/home-hero-card-left-top.png",
          "/assets/images/home-hero-card-left-bottom.png",
          "/assets/images/home-hero-card-right-top.png",
          "/assets/images/hero-mens-left-top.png",
          "/assets/images/hero-mens-left-bottom.png",
          "/assets/images/hero-mens-right-top.png",
          "/assets/images/hero-mens-right-bottom.png",
          "/assets/images/hero-phones-left-top.png",
          "/assets/images/hero-phones-left-bottom.png",
          "/assets/images/hero-phones-right-top.png",
          "/assets/images/hero-phones-right-bottom.png",
          "/assets/images/hero-cars-left-top.png",
          "/assets/images/hero-cars-left-bottom.png",
          "/assets/images/hero-cars-right-top.png",
          "/assets/images/hero-cars-right-bottom.png",
          "/assets/images/hero-womens-left-top.png",
          "/assets/images/hero-womens-left-bottom.png",
          "/assets/images/hero-womens-right-top.png",
          "/assets/images/hero-womens-right-bottom.png",
          "/assets/images/hero-properties-left-top.png",
          "/assets/images/hero-properties-left-bottom.png",
          "/assets/images/hero-properties-right-top.png",
          "/assets/images/hero-properties-right-bottom.png",
          "/assets/images/hero-electronics-left-top.png",
          "/assets/images/hero-electronics-left-bottom.png",
          "/assets/images/hero-electronics-right-top.png",
          "/assets/images/hero-electronics-right-bottom.png",
          "/assets/images/home-promo-2.png",
          "/assets/images/home-promo-3.png",
          "/assets/icons/home-hero-rotator/*.svg",
          "/assets/icons/home-search.svg",
          "/assets/icons/category-*.svg",
          "/assets/images/category-*.png",
          "/assets/images/logo-*.svg",
          "/assets/images/footer-*.svg",
          "/assets/images/home-*.png",
          "/assets/images/home-*.svg",
          "/assets/icons/home-*.svg",
          "/assets/icons/home-logo-*.svg",
          "/assets/icons/home-search-overlay/*.svg",
          "/assets/icons/home-mobile-menu/*.svg",
          "/assets/icons/buyer-header/*.svg",
          "/assets/icons/buyer-menu/*.svg",
          "/assets/images/auth-avatar-fallback.svg",
          "/assets/images/image-*-*.jpg",
          "/assets/icons/buyer-bottom-nav/*.svg",
          "/assets/icons/home-nav-*.svg",
          "/assets/images/hero-*.png",
          "/assets/images/product_*.png"
        ]
      }
    },
    {
      "name": "auth-pages",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/assets/images/auth-shell-*.webp",
          "/assets/images/auth-shell-*.svg",
          "/assets/images/forgot-password-success-illustration.webp",
          "/assets/icons/signin-*.svg",
          "/assets/icons/signup-*.svg",
          "/assets/icons/forgot-password-*.svg",
          "/assets/icons/auth-*.svg"
        ]
      }
    },
    {
      "name": "static-assets",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "files": [
          "/assets/**",
          "/icons/**",
          "/*.(png|jpg|jpeg|svg|webp|avif|woff2)"
        ]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "marketplace-media",
      "urls": [
        "/media/**",
        "https://ddb.sft.org.ng/media/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 160,
        "maxAge": "7d",
        "timeout": "3s",
        "refreshAhead": "1d"
      }
    },
    {
      "name": "google-font-styles",
      "urls": [
        "https://fonts.googleapis.com/**"
      ],
      "cacheConfig": {
        "strategy": "freshness",
        "maxSize": 8,
        "maxAge": "7d",
        "timeout": "2s"
      }
    },
    {
      "name": "google-font-files",
      "urls": [
        "https://fonts.gstatic.com/**"
      ],
      "cacheConfig": {
        "strategy": "performance",
        "maxSize": 16,
        "maxAge": "365d"
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/*__*",
    "!/**/*__*/**",
    "!/api/**",
    "!/media/**"
  ]
}
